# PocketBase URL the client talks to (prod: https://api.<domain>)
PUBLIC_PB_URL=http://127.0.0.1:8090
# TEMPORARY until Prompt 04 ships auth UI — set false once login works
PUBLIC_DEV_BYPASS_AUTH=true
# Groq key for the ingestion CLI (scripts/ingest)
# GROQ_API_KEY=gsk_...

# --- Razorpay (Prompt 14) — set on the PocketBase SERVER, never in the client ---
# Test-mode keys for dev; live keys on the VPS only. When BOTH are unset you can
# run the payment flow offline for e2e by setting PAY_SIMULATE=1 (see below).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Dev/e2e ONLY: simulate captured payments without contacting Razorpay. MUST be
# unset in production (with real keys present this flag is ignored anyway).
# PAY_SIMULATE=1

# --- OneSignal web push (Prompt 15) ---
# PUBLIC_* reaches the browser (SDK init); REST key is SERVER-only (cron sends).
# All unset ⇒ push is a no-op client-side and sends dry-log server-side.
# PUBLIC_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # server (same id)
# ONESIGNAL_REST_KEY=os_v2_...                            # server only

# --- PostHog analytics (Prompt 15) — PUBLIC (client capture) ---
# Unset ⇒ analytics is a no-op (dev/e2e send nothing).
# PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
