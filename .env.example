# PocketBase URL the client talks to
#   local  http://127.0.0.1:8090
#   beta   https://<name>.pockethost.io
#   launch https://api.<domain>
PUBLIC_PB_URL=http://127.0.0.1:8090
# MUST stay false. Auth shipped in Prompt 04; `true` skips login entirely and
# would hand every visitor an authenticated session.
PUBLIC_DEV_BYPASS_AUTH=false

# --- content CLI (scripts/content: validate | sync | repair:pyq) ---
# Superuser of the target PocketBase. Never commit real values.
# PB_ADMIN_EMAIL=you@example.com
# PB_ADMIN_PASSWORD=...
# PB_URL_DEV=http://127.0.0.1:8090
# PB_URL_PROD=https://<name>.pockethost.io

# --- AI: ingestion CLI (scripts/ingest) + CA pipeline drafting ---
# All speak the OpenAI chat-completions shape; only base URL/model/key differ.
# A call starts at the first configured provider below and FAILS OVER to the
# next when that one is out of quota / rejects the key, so a long batch survives
# a daily cap. All unset ⇒ ingest falls back to heuristics and the CA pipeline
# runs heuristic mode.
# OPENROUTER_API_KEY=sk-or-v1-...            # openrouter.ai/keys
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # default
#   free tier: 50 req/day (1000/day once >=10 credits bought), ~25s/question
# GEMINI_API_KEY=AQ....                      # Google Antigravity key (or AIza... from AI Studio)
# GEMINI_MODEL=gemini-3.6-flash              # 1M ctx, native JSON mode, ~5s/question
#   Pro models (gemini-3.1-pro-preview) return 429 on an Antigravity key.
# MISTRAL_API_KEY=...                        # console.mistral.ai
# MISTRAL_MODEL=mistral-large-latest         # 262k ctx
#   free tier: 50 req/min + 50000 tokens/min (no daily cap in the headers)
# OPENCODE_API_KEY=sk-...                    # OpenCode Zen gateway, all free tier
# OPENCODE_MODEL=deepseek-v4-flash-free      # or mimo-v2.5-free / nemotron-3-ultra-free
#   no rate-limit headers; ling-3.0-flash-free 400s and laguna-s-2.1-free 429s
# GROQ_API_KEY=gsk_...                       # console.groq.com
# GROQ_MODEL=llama-3.3-70b-versatile
#   free tier: 1000 req/day + 12000 tokens/min, ~1s/question
# Pin to ONE provider (disables failover): openrouter|gemini|mistral|opencode|groq
# AI_PROVIDER=mistral

# --- Razorpay (Prompt 14) — set on the PocketBase SERVER, never in the client ---
# Test-mode keys for dev; live keys on the VPS only. When BOTH are unset you can
# run the payment flow offline for e2e by setting PAY_SIMULATE=1 (see below).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Dev/e2e ONLY: simulate captured payments without contacting Razorpay. MUST be
# unset in production (with real keys present this flag is ignored anyway).
# PAY_SIMULATE=1

# --- OneSignal web push (Prompt 15) ---
# PUBLIC_* reaches the browser (SDK init); REST key is SERVER-only (cron sends).
# All unset ⇒ push is a no-op client-side and sends dry-log server-side.
# PUBLIC_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # server (same id)
# ONESIGNAL_REST_KEY=os_v2_...                            # server only

# --- PostHog analytics (Prompt 15) — PUBLIC (client capture) ---
# Unset ⇒ analytics is a no-op (dev/e2e send nothing).
# PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
